# 다른 개발자/배포 환경용 템플릿. 실제 값은 .env 또는 IntelliJ Run Config 에.
# 값은 다음 명령으로 받을 수 있음:
#   terraform -chdir=../infrastructure-as-code/terraform/s3 output -raw iam_access_key_id
#   terraform -chdir=../infrastructure-as-code/terraform/s3 output -raw iam_secret_access_key

AWS_S3_BUCKET=meeny-uploads-dev
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_PRESIGNED_URL_EXPIRY_MINUTES=10
AWS_S3_READ_URL_EXPIRY_MINUTES=60
